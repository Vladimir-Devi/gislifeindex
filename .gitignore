# Keep the repository focused on the deployable site project.
*

!.gitignore
!site/
!site/**
!site_cesium_v2/
!site_cesium_v2/**
!deploy/
!deploy/**

# Generated deployment output.
site_dist/

# Local/generated frontend artifacts.
site/tmp_*.png
site/node_modules/
site/.wrangler/
site/.cache/
site_cesium_v2/server.*.log
site_cesium_v2/node_modules/
site_cesium_v2/vendor/cesium/
site_cesium_v2/tmp_chrome_profile*/

# Heavy source GIS files are converted into deployable data before build.
site/data/_raw/

# Local secrets and OS files.
.env
.env.*
site/.env
site/.env.*
.DS_Store
Thumbs.db
