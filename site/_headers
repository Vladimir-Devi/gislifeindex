/src/*
  Cache-Control: public, max-age=31536000, immutable

/data3d/*
  Cache-Control: public, max-age=31536000, immutable

/data3d/manifest.json
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/data3d/:city/quartals.json
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/data3d/:city/quartals-meta.json
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate

/public/*
  Cache-Control: public, max-age=31536000, immutable

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/3d.html
  Cache-Control: public, max-age=0, must-revalidate
